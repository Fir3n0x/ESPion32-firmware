# --- FLASH SIZE (IMPORTANT) ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# --- BLUETOOTH ---
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_GATT_CLIENT_ENABLE=y
CONFIG_BT_GATT_SERVER_ENABLE=y
# --- FreeRTOS tick 1 ms (deauth/capture timing) ---
CONFIG_FREERTOS_HZ=1000
